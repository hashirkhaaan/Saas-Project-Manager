# ===========================
# Combined Gitignore for MERN
# ===========================

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment Variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Frontend Build output (Vite/React)
frontend/dist/
frontend/dist-ssr/
frontend/build/
.eslintcache

# Backend Specifics
backend/public/temp/*
!backend/public/temp/.gitkeep

# Editor directories and files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db